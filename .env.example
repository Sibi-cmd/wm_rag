# =====================================================================
# .env.example
# Template for environment variables required by rag_core.
# Copy this file to '.env' and fill in your actual API keys.
# =====================================================================

# 1. OpenAI or OpenAI-Compatible API Key (Required if using cloud generators)
#OPENAI_API_KEY=your_openai_api_key_here

# 2. Pinecone API Key (Required only if using Pinecone vector store)
#PINECONE_API_KEY=your_pinecone_api_key_here

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Qdrant
QDRANT_URL=YOUR_QDRANT_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY

# Redis (only if required)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (only if required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=wm_rag